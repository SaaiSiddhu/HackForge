# HackForge Environment Configuration Example
# Copy this file to .env for local development overrides:
#   cp .env.example .env
#
# DO NOT commit real secrets or credentials to version control.

# Application Environment: development | production | testing
ENVIRONMENT=development

# Database connection URL (PostgreSQL required for development/production)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://hackforge:hackforge-local-demo@db:5432/hackforge

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Path to the official fixtures dataset
FIXTURE_PATH=fixtures.json

# Automatically seed fixtures on container startup (idempotent, preserves local edits)
SEED_FIXTURES=true

# Host and port for the application server
HOST=0.0.0.0
PORT=8080

# PostgreSQL container password (used by docker-compose)
POSTGRES_PASSWORD=hackforge-local-demo
